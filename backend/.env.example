# Universal Ergonomics Backend Configuration
# Copy this to .env and fill in your values

# App
APP_NAME=Universal Ergonomics
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/universal_ergonomics
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/universal_ergonomics

# Redis
REDIS_URL=redis://localhost:6379/0

# Telegram Bot (for warehouse inventory sync)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WAREHOUSE_CHAT_ID=

# WhatsApp Business API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Razorpay (payment gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AWS S3 (product images)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=universal-ergonomics-assets
AWS_REGION=ap-south-1

# Scraping
SCRAPE_INTERVAL_HOURS=6
